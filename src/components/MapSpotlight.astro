---
// The Project Map, shown off: a big screenshot, what it does in six points and
// links to its feature page and docs. The home page uses it as a section; the
// /features page puts it above the grid, with the gallery of extra captures.
//
// Screenshots follow the docs figures' convention (src/lib/rehype-doc-figures.mjs):
// 2x captures in the app's light theme, with a `.dark` twin the dark site
// themes show instead. Gallery shots in public/screenshots/map/ appear as soon
// as their file exists, so a capture can be added without touching this file.
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { docsBase } from "../lib/editora";

interface Props {
  /** Show the gallery of extra Map captures under the points. */
  gallery?: boolean;
  /** Heading id, so a page index can jump to it. */
  id?: string;
}

const { gallery = false, id } = Astro.props;

const dark = (src: string) => {
  const d = src.replace(/\.png$/, ".dark.png");
  return existsSync(resolve("public", d.slice(1))) ? d : null;
};

const hero = {
  src: "/screenshots/docs/project-map.png",
  alt: "The Project Map window: folder columns from the project root down to a Java package, the selected Shelf.java, its Structure column and a column of the Shelf class's members, joined by connectors",
  caption:
    "Folders open as columns along the flow; a file's Structure opens past it.",
};

const shots = [
  {
    src: "/screenshots/map/references.png",
    alt: "Show Callers as Cards on Pricing.apply: the callers in Shelf.checkout and two ShelfTest tests open as cards around Pricing.java, each joined to it by an edge labelled by name",
    caption: "Show Callers as Cards: every call site opens around the declaration, one edge each.",
  },
  {
    src: "/screenshots/map/recent-changes.png",
    alt: "Show recent changes on the Editora repo: rows tinted and underlined by how often they changed, with a tooltip reading 5 commits in 90 days, last: Adrian De Leon, 2 weeks ago, and Owners: @adriandeleon from .github/CODEOWNERS",
    caption: "Show recent changes warms the rows where the work happens; tooltips name the owners.",
  },
  {
    src: "/screenshots/map/trail.png",
    alt: "A trail playing: the bar reads Stop 2 of 4, Pricing.discountFor, the card highlights that method's lines and the stop's note is stuck beside it",
    caption: "A trail walks the team through the code, a note at every stop.",
  },
  {
    src: "/screenshots/map/filters.png",
    alt: "Git changed with Hide unmatched on: only the changed files and the folders that lead to them stay, with a 65 rows hidden badge and shown/total counts on each column",
    caption: "Filters narrow the map and count what they hide.",
  },
].filter((s) => existsSync(resolve("public", s.src.slice(1))));

const points = [
  {
    title: "Columns on a canvas",
    body: "Folders open Miller-style along a flow you choose. Pan, zoom from 15% to 225%, and the path you came by stays on screen.",
    icon: "M3 5h4v14H3zM10 5h4v9h-4zM17 5h4v6h-4z",
  },
  {
    title: "Cards beside the map",
    body: "Preview a file or just one method in a card tied to its row. Pin it, search it, step through declarations.",
    icon: "M4 4h11v12H4zM9 9h11v11H9z",
  },
  {
    title: "Callers as cards",
    body: "Show Callers or References as Cards opens every call site around the declaration, joined by labelled edges.",
    icon: "M12 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0M4 5h4v4H4zM16 5h4v4h-4zM10 18h4v4h-4zM8 8l2.3 2.3M16 8l-2.3 2.3M12 14.5V18",
  },
  {
    title: "Search the whole project",
    body: "Names, path fragments, # for files and @ for declarations, ranked as you type, with filters for Git, notes and more.",
    icon: "M10.5 10.5m-6.5 0a6.5 6.5 0 1 0 13 0a6.5 6.5 0 1 0 -13 0M15.5 15.5L21 21",
  },
  {
    title: "Where the work happens",
    body: "Recent-change heat over 90 days, owners from CODEOWNERS or OWNERS files, and a project overview card.",
    icon: "M4 20V12M10 20V6M16 20v-9M22 20H2",
  },
  {
    title: "Working sets and trails",
    body: "Save a view to come back to, or record a guided tour of the code that the team can commit.",
    icon: "M5 19c3-1 3-6 7-7s4-6 7-7M5 19m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M19 5m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0",
  },
];

const heroDark = dark(hero.src);
---

<div class="map-spot">
  <span class="eyebrow">Project Map</span>
  <h2 id={id}>Your project, as a map</h2>
  <p class="lead">
    A file tree shows one folder at a time. The Project Map lays the whole
    path out on a canvas in a window of its own, keeps the code you are
    reading beside it, and shows how it connects: who calls it, what changed
    lately, and who owns it.
  </p>

  <figure class="doc-figure map-hero">
    <a class={`doc-figure-link${heroDark ? " doc-figure-light" : ""}`} href={hero.src} title="Open the full-size screenshot">
      <img src={hero.src} alt={hero.alt} width="1360" height="760" loading="lazy" decoding="async" />
    </a>
    {
      heroDark && (
        <a class="doc-figure-link doc-figure-dark" href={heroDark} title="Open the full-size screenshot">
          <img src={heroDark} alt={hero.alt} width="1360" height="760" loading="lazy" decoding="async" />
        </a>
      )
    }
    <figcaption>{hero.caption}</figcaption>
  </figure>

  <ul class="map-points">
    {
      points.map((p) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={p.icon} />
          </svg>
          <strong>{p.title}</strong>
          <span>{p.body}</span>
        </li>
      ))
    }
  </ul>

  {
    gallery && shots.length > 0 && (
      <div class="map-gallery">
        {shots.map((s) => {
          const d = dark(s.src);
          return (
            <figure class="doc-figure">
              <a class={`doc-figure-link${d ? " doc-figure-light" : ""}`} href={s.src} title="Open the full-size screenshot">
                <img src={s.src} alt={s.alt} loading="lazy" decoding="async" />
              </a>
              {d && (
                <a class="doc-figure-link doc-figure-dark" href={d} title="Open the full-size screenshot">
                  <img src={d} alt={s.alt} loading="lazy" decoding="async" />
                </a>
              )}
              <figcaption>{s.caption}</figcaption>
            </figure>
          );
        })}
      </div>
    )
  }

  <p class="map-cta">
    <a class="map-btn map-btn-primary" href="/features/project-map">Explore the Project Map</a>
    <a class="map-btn" href={`${docsBase}/workspace/#project-map`}>Read the Map docs</a>
  </p>
</div>

<style>
  .eyebrow {
    display: inline-block;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  h2 {
    font-size: 1.9rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
    scroll-margin-top: 4.5rem;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 1.75rem;
    max-width: 44rem;
  }
  .map-hero {
    margin: 0 0 2rem;
  }
  .map-hero .doc-figure-link {
    box-shadow:
      0 20px 50px -24px rgba(0, 0, 0, 0.6),
      0 0 0 1px var(--border-soft);
  }
  .map-points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.4rem 1.75rem;
  }
  .map-points li {
    display: grid;
    grid-template-columns: 26px 1fr;
    column-gap: 0.7rem;
    row-gap: 0.25rem;
  }
  .map-points svg {
    grid-row: span 2;
    width: 24px;
    height: 24px;
    color: var(--accent);
    margin-top: 0.05rem;
  }
  .map-points strong {
    color: var(--text);
    font-size: 1rem;
  }
  .map-points span {
    color: var(--muted);
    font-size: 0.93rem;
  }
  .map-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr));
    gap: 0.75rem 1.5rem;
    margin-top: 2.5rem;
  }
  .map-gallery .doc-figure {
    margin: 0;
  }
  .map-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2.25rem 0 0;
  }
  .map-btn {
    display: inline-block;
    padding: 0.65rem 1.35rem;
    border-radius: 999px;
    font-weight: 600;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-soft);
  }
  .map-btn:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .map-btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
</style>
