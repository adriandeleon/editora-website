---
// "Uses the tools you already have" — Editora's external-CLI design, framed as
// the advantage it is, plus Doctor (the health screen that reports on all of
// them). Tool list mirrors what the app actually shells out to; the Doctor shot
// falls back to a generated stand-in until a real capture is dropped in as
// public/screenshots/doctor.png (raster wins over the .svg).
import { existsSync } from "node:fs";
import { resolve } from "node:path";

const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base}/${p}`.replace(/\/{2,}/g, "/");

const shotExts = ["png", "jpg", "jpeg", "webp", "avif", "svg"];
const shotPath = shotExts
  .map((e) => `screenshots/doctor.${e}`)
  .find((p) => existsSync(resolve("public", p)));
const isStandIn = !!shotPath && shotPath.endsWith(".svg");

const tools = [
  { name: "git", note: "Version control, blame, diffs" },
  { name: "gh", note: "Pull requests, issues, CI runs" },
  { name: "ripgrep", note: "Faster Find in Files" },
  { name: "22 language servers", note: "Completion, diagnostics" },
  { name: "Debug adapters", note: "Java, Python, JavaScript" },
  { name: "mmdc", note: "Mermaid diagrams" },
  { name: "dot / plantuml", note: "Graphviz and PlantUML" },
  { name: "typst", note: "Typst documents" },
  { name: "mvn / gradle / npm", note: "Builds, tests, tasks" },
];

const reasons = [
  {
    title: "Your versions, your config",
    body: "The git you already configured, the language server your project pins, the build wrapper the repo ships. No second copy drifting out of date.",
  },
  {
    title: "Nothing you can't use is in the way",
    body: "Every integration self-gates: it stays hidden until its tool is detected, so the interface only ever shows what actually works on your machine.",
  },
  {
    title: "A smaller, honest app",
    body: "No vendored toolchains inflating the download or quietly going stale, and nothing extra to trust — the tools are the ones you already installed.",
  },
];
---

<div class="belt">
  <ul class="belt-tools">
    {
      tools.map((t) => (
        <li class="belt-tool">
          <code>{t.name}</code>
          <span>{t.note}</span>
        </li>
      ))
    }
  </ul>

  <div class="belt-reasons">
    {
      reasons.map((r) => (
        <div class="belt-reason">
          <strong>{r.title}</strong>
          <span>{r.body}</span>
        </div>
      ))
    }
  </div>

  <div class="doctor">
    <div class="doctor-copy">
      <h4>
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s-7-4.3-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.7-7 10-7 10Z" />
          <path d="M8.5 11h2l1-2 1.5 4 1-2h2" />
        </svg>
        Doctor
      </h4>
      <p>
        Because the tools live outside the app, Editora ships a health screen
        that shows exactly what it found. Every integration is listed with its
        version and resolved path, warnings for anything half-configured (a
        <code>gh</code> that isn't signed in, a JDK too old to run a file), and
        a red row for what's missing.
      </p>
      <p>
        Missing tools that Editora knows how to fetch get an
        <strong>Install…</strong> button right there, and the whole screen
        re-checks live &mdash; no restart, no hunting through settings.
      </p>
      <p class="doctor-run">
        Run it from the palette: <code>view.doctor</code> &middot;
        <a href="/features/doctor">More about Doctor</a>
      </p>
    </div>

    {
      shotPath && (
        <figure class="doctor-shot">
          <img
            src={url(shotPath)}
            alt="Editora's Doctor screen listing external tools with found, warning, and missing status"
            loading="lazy"
          />
          {isStandIn && (
            <figcaption>
              <span class="doctor-badge">Stand-in</span>
              Replaced automatically by a real capture.
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</div>

<style>
  .belt {
    margin-top: 2rem;
  }

  .belt-tools {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 0.5rem 1.25rem;
  }
  .belt-tool {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--border-soft);
    font-size: 0.88rem;
  }
  .belt-tool code {
    flex: none;
    color: var(--tok-string);
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
    font-size: 0.82rem;
  }
  .belt-tool span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .belt-reasons {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem 1.5rem;
    margin-top: 2rem;
  }
  .belt-reason {
    border-left: 2px solid var(--accent);
    padding: 0.1rem 0 0.1rem 1rem;
  }
  .belt-reason strong {
    display: block;
    font-size: 0.98rem;
    margin-bottom: 0.3rem;
  }
  .belt-reason span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* --- Doctor --- */
  .doctor {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 2rem;
    align-items: start;
    margin-top: 2.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border-soft);
  }
  .doctor-copy h4 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.6rem;
    font-size: 1.15rem;
    color: var(--text);
  }
  .doctor-copy h4 svg {
    color: var(--accent);
  }
  .doctor-copy p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .doctor-copy strong {
    color: var(--text);
  }
  .doctor-run {
    color: var(--faint) !important;
    font-size: 0.85rem !important;
  }

  .doctor-shot {
    margin: 0;
  }
  .doctor-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px -20px rgba(0, 0, 0, 0.6);
  }
  .doctor-shot figcaption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.7rem;
    color: var(--faint);
    font-size: 0.8rem;
  }
  .doctor-badge {
    flex: none;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 999px;
    padding: 0.08rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 720px) {
    .doctor {
      grid-template-columns: 1fr;
    }
  }
</style>
