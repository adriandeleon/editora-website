---
// "Your keymap, your keys": the same everyday actions, side by side across all
// five bundled keymaps — the interactive proof of Editora's identity. Data comes
// straight from src/lib/commands.ts (generated from the real keymap JSONs), so
// the chords can't drift from the app. Tabs highlight one keymap's column and,
// on narrow screens, collapse the matrix to Action + that keymap.
import { commandGroups, keymaps } from "../lib/commands";

const byId = new Map<string, (typeof commandGroups)[number]["commands"][number]>();
for (const g of commandGroups) for (const c of g.commands) byId.set(c.id, c);

const picks = [
  { id: "palette.show", label: "Command palette" },
  { id: "file.save", label: "Save" },
  { id: "file.find", label: "Go to file" },
  { id: "find.show", label: "Find in file" },
  { id: "search.inFiles", label: "Find in files" },
  { id: "find.replace", label: "Replace" },
  { id: "edit.toggleComment", label: "Toggle comment" },
  { id: "edit.duplicateLine", label: "Duplicate line" },
  { id: "edit.moveLineUp", label: "Move line up" },
  { id: "edit.undo", label: "Undo" },
  { id: "lsp.gotoDefinition", label: "Go to definition" },
  { id: "nav.goToLine", label: "Go to line" },
];

const chordFor = (id: string, km: string): string | null => {
  const c = byId.get(id);
  if (!c) return null;
  if (km === "emacs") return c.bindings?.emacs ?? c.keys ?? null;
  return c.bindings?.[km] ?? null;
};

const rows = picks
  .filter((p) => byId.has(p.id))
  .map((p) => ({
    label: p.label,
    cells: keymaps.map((k) => ({ km: k.id, chord: chordFor(p.id, k.id) })),
  }));

const defaultKm = "vscode";
// Chords are multi-key sequences ("C-x C-f") — split on spaces into kbds.
const parts = (chord: string) => chord.split(" ");
---

<div class="km-wrap" data-active={defaultKm}>
  <div class="km-tabs" role="tablist" aria-label="Keymap">
    {
      keymaps.map((k) => (
        <button
          class="km-tab"
          type="button"
          role="tab"
          data-km-tab={k.id}
          aria-selected={k.id === defaultKm ? "true" : "false"}
        >
          {k.name}
        </button>
      ))
    }
  </div>

  <div class="km-scroll">
    <table class="km-table">
      <thead>
        <tr>
          <th class="km-action-h" scope="col">Action</th>
          {
            keymaps.map((k) => (
              <th class="km-col" data-km={k.id} scope="col">
                {k.name}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th class="km-action" scope="row">
                {r.label}
              </th>
              {r.cells.map((cell) => (
                <td class="km-col" data-km={cell.km}>
                  {cell.chord ? (
                    <span class="km-chord">
                      {parts(cell.chord).map((p) => (
                        <kbd>{p}</kbd>
                      ))}
                    </span>
                  ) : (
                    <span class="km-none" aria-label="not bound">
                      &mdash;
                    </span>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="km-note">
    Windows/Linux chords shown &mdash; macOS substitutes <kbd>&#8984;</kbd>. Every
    binding is editable in Settings, and a blank cell just means that keymap
    leaves the action to the palette.
  </p>
</div>

<script is:inline>
  (function () {
    document.querySelectorAll(".km-wrap").forEach(function (wrap) {
      var tabs = wrap.querySelectorAll("[data-km-tab]");
      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          var km = tab.getAttribute("data-km-tab");
          wrap.setAttribute("data-active", km);
          tabs.forEach(function (t) {
            t.setAttribute(
              "aria-selected",
              t === tab ? "true" : "false",
            );
          });
        });
      });
    });
  })();
</script>

<style>
  .km-wrap {
    margin-top: 1rem;
  }
  .km-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .km-tab {
    font: inherit;
    font-size: 0.9rem;
    color: var(--muted);
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }
  .km-tab:hover {
    color: var(--text);
    border-color: var(--accent);
  }
  .km-tab[aria-selected="true"] {
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  .km-scroll {
    overflow-x: auto;
  }
  .km-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .km-table th,
  .km-table td {
    text-align: left;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--border-soft);
    white-space: nowrap;
  }
  .km-table thead th {
    color: var(--faint);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 1px solid var(--border);
  }
  .km-action,
  .km-action-h {
    color: var(--text);
    font-weight: 600;
    position: sticky;
    left: 0;
    background: var(--bg);
  }
  .km-action {
    font-weight: 500;
  }
  .km-chord {
    display: inline-flex;
    gap: 0.25rem;
  }
  .km-chord kbd {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    padding: 0.05rem 0.4rem;
    font-size: 0.82em;
    color: var(--text);
  }
  .km-none {
    color: var(--faint);
  }
  .km-note {
    color: var(--faint);
    font-size: 0.85rem;
    margin: 1rem 0 0;
  }

  /* Highlight the selected keymap's column. */
  .km-wrap[data-active="emacs"] [data-km="emacs"],
  .km-wrap[data-active="cua"] [data-km="cua"],
  .km-wrap[data-active="sublime"] [data-km="sublime"],
  .km-wrap[data-active="vscode"] [data-km="vscode"],
  .km-wrap[data-active="intellij"] [data-km="intellij"] {
    background: var(--accent-soft);
  }
  .km-wrap[data-active="emacs"] thead [data-km="emacs"],
  .km-wrap[data-active="cua"] thead [data-km="cua"],
  .km-wrap[data-active="sublime"] thead [data-km="sublime"],
  .km-wrap[data-active="vscode"] thead [data-km="vscode"],
  .km-wrap[data-active="intellij"] thead [data-km="intellij"] {
    color: var(--accent);
  }

  /* On narrow screens, collapse to Action + the selected keymap only. */
  @media (max-width: 640px) {
    .km-col {
      display: none;
    }
    .km-wrap[data-active="emacs"] [data-km="emacs"],
    .km-wrap[data-active="cua"] [data-km="cua"],
    .km-wrap[data-active="sublime"] [data-km="sublime"],
    .km-wrap[data-active="vscode"] [data-km="vscode"],
    .km-wrap[data-active="intellij"] [data-km="intellij"] {
      display: table-cell;
    }
  }
</style>
