---
// Cold-start bar chart for the "Built for speed" section. The figures live in
// src/lib/bench.ts, shared with /compare; read the rules there before changing
// one.
//
// The metric is when the editor's window for the file appears — the moment its
// title names the file. That is earlier than the first frame showing the file's
// text, and the caption says so rather than letting the stronger reading stand.
// The same gap exists for the other two and cannot be measured from outside, so
// all three bars are the window-appears moment and none of them is first paint.
//
// `methodology` renders under the chart and is not optional. A benchmark
// without its conditions stated is a claim nobody can check.
import { version } from "../lib/editora";
import { editoraInternal, measured, secs, startup } from "../lib/bench";

const bars = startup.file.map((r) => ({ label: r.name, sub: r.ver, ms: r.ms, highlight: !!r.self }));
const editoraMs = startup.file.find((r) => r.self)!.ms;

// Said above the chart, not only in the small print: the figures are from an
// older release than the one on the download button.
const asOf =
  `Measured in ${measured.month} on Editora ${measured.editoraVersion}, on ${measured.machineShort}` +
  (measured.editoraVersion === version ? "." : `; not yet re-run on ${version}.`);

const methodology =
  "Median of five timed runs per " +
  "editor (a discarded warm-up first), all on one 14-inch MacBook Pro " +
  "(Mac17,2): Apple M5, 10 cores (4 performance, 6 efficiency), 16 GB of " +
  "memory, Apple's 1 TB internal SSD, macOS 27.0 (build 26A428), on AC power, " +
  "painting to a 5120\u00d72880 external display. " +
  "Each run opened the same 710-line Markdown file with no project or " +
  "workspace loaded. Every editor was fully quit between runs and launched " +
  "the same way. " +
  "The clock stops when a window owned by that editor is titled with the " +
  "file's name, not when a splash screen appears: IntelliJ puts up a splash " +
  "and a welcome window well before its editor exists. That moment is when the " +
  "window arrives, which comes before the file's text is painted — Editora's " +
  `own instrumentation puts its first frame showing the file at ${secs(editoraInternal.firstPaintMs)} against ` +
  `the ${secs(editoraMs)} here, and the other two have a gap of their own that we cannot ` +
  "measure from outside. These are relaunches on a warm page cache rather than " +
  "a first boot, and none of them measure background work that continues " +
  "afterwards.";

const max = Math.max(...bars.map((b) => b.ms));
const pct = (ms: number) => Math.round((ms / max) * 100);
---

<figure class="speed">
  <p class="speed-asof">{asOf}</p>
  <div class="speed-rows">
    {
      bars.map((b) => (
        <div class={`speed-row${b.highlight ? " is-primary" : ""}`}>
          <div class="speed-label">
            <strong>{b.label}</strong>
            <span>{b.sub}</span>
          </div>
          <div class="speed-track">
            <div class="speed-bar" style={`--w:${pct(b.ms)}%`}>
              <span class="speed-value">{secs(b.ms)}</span>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <figcaption>
    <strong>Time from launch to the editor's window for your file appearing.</strong>
    {methodology}{" "}
    <a href="/compare">Full method and a project-folder comparison</a>.
  </figcaption>
</figure>

<style>
  .speed {
    margin: 2.5rem 0 0;
  }
  .speed-asof {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.88rem;
  }
  .speed-rows {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .speed-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    align-items: center;
    gap: 1rem;
  }
  .speed-label {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    text-align: right;
  }
  .speed-label strong {
    font-size: 0.95rem;
    color: var(--text);
  }
  .speed-label span {
    font-size: 0.78rem;
    color: var(--faint);
  }
  .speed-track {
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 7px;
    overflow: hidden;
  }
  .speed-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: var(--w);
    min-width: 4.5rem;
    height: 2.1rem;
    padding-right: 0.65rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--muted) 30%, transparent);
    /* Grow from the left on first paint; the width is the datum, so the
       animation only affects how it arrives. */
    animation: speed-grow 0.5s ease-out both;
  }
  .is-primary .speed-bar {
    background: var(--accent);
  }
  .speed-value {
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text);
  }
  .is-primary .speed-value {
    color: var(--on-accent);
  }

  @keyframes speed-grow {
    from {
      width: 0;
    }
    to {
      width: var(--w);
    }
  }

  .speed figcaption {
    margin-top: 1.25rem;
    color: var(--faint);
    font-size: 0.82rem;
    line-height: 1.6;
    max-width: 44rem;
  }
  .speed figcaption strong {
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .speed-bar {
      animation: none;
    }
  }

  @media (max-width: 560px) {
    .speed-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .speed-label {
      text-align: left;
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
    }
  }
</style>
