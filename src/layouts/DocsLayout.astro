---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import { currentDocVersion, docVersions, type DocVersion } from "../lib/doc-versions";

type DocEntry = CollectionEntry<"docs"> | CollectionEntry<"docsArchive">;

interface Props {
  entry: DocEntry;
  /** Defaults to the current version, so a caller predating versioning still works. */
  docVersion?: DocVersion;
}
const { entry, docVersion = currentDocVersion } = Astro.props;
const base = docVersion.base;
const archived = !docVersion.current;

// Build the ordered sidebar: categories in a fixed order, docs by `order`.
const CATEGORY_ORDER = [
  "Getting started",
  "Editing",
  "Code intelligence",
  "Navigation",
  "Run & debug",
  "Version control",
  "Workspace",
  "Customization",
  "Help",
];

// The sidebar comes from the version being rendered, not from the live docs:
// an archived release's page list is its own (0.9.10 has no editor-groups page).
// Archived ids are "<version>/<slug>", stripped back to the slug the route uses.
const prefix = docVersion.archive === null ? "" : `${docVersion.archive}/`;
const pages = (
  docVersion.archive === null
    ? (await getCollection("docs")).map((e) => ({ entry: e as DocEntry, slug: e.id }))
    : (await getCollection("docsArchive"))
        .filter((e) => e.id.startsWith(prefix))
        .map((e) => ({ entry: e as DocEntry, slug: e.id.slice(prefix.length) }))
).sort(
  (a, b) =>
    (a.entry.data.order ?? 100) - (b.entry.data.order ?? 100) ||
    a.entry.data.title.localeCompare(b.entry.data.title),
);

const cats = [
  ...new Set([...CATEGORY_ORDER, ...pages.map((p) => p.entry.data.category)]),
].filter((c) => pages.some((p) => p.entry.data.category === c));

type Page = (typeof pages)[number];
const href = (p: Page) => (p.slug === "introduction" ? base : `${base}/${p.slug}`);

// Flat order for prev/next.
const flat = cats.flatMap((c) => pages.filter((p) => p.entry.data.category === c));
const idx = flat.findIndex((p) => p.entry.id === entry.id);
const prev = idx > 0 ? flat[idx - 1] : null;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;

// Where "read the current version" goes. An archived page whose topic has since
// been removed or renamed points at the current docs root rather than a 404.
const thisSlug = prefix && entry.id.startsWith(prefix) ? entry.id.slice(prefix.length) : entry.id;
const currentSlugs = new Set((await getCollection("docs")).map((d) => d.id));
const latestHref = !archived
  ? null
  : thisSlug === "introduction" || !currentSlugs.has(thisSlug)
    ? currentDocVersion.base
    : `${currentDocVersion.base}/${thisSlug}`;

const reference = [
  { href: "/commands", label: "Commands" },
  { href: "/keybindings", label: "Keybindings" },
  { href: "/plugins", label: "Plugins catalog" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/screenshots", label: "Screenshots" },
];

const { Content } = await render(entry);

// The FAQ page is a flat list of `## Question?` headings followed by their
// answer, which is exactly the shape schema.org's FAQPage wants. Emitting it
// lets search engines show the questions directly. Built from the raw body so
// it can never drift from what the page renders; answers are flattened to
// plain text (links and code spans stripped) and capped, since the schema is a
// summary rather than a copy of the page.
const faqJsonLd =
  entry.id === "faq"
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        // Split rather than a lookahead regex: an earlier version ended the
        // answer at `(?=^##\s|\Z)`, but \Z is not a JavaScript anchor (it
        // matches a literal "Z"), so the final question never matched and the
        // page shipped 11 of its 12 questions.
        mainEntity: entry.body
          .split(/^##\s+/m)
          .slice(1)
          .map((block) => {
            const nl = block.indexOf("\n");
            const q = (nl === -1 ? block : block.slice(0, nl)).trim();
            const a = nl === -1 ? "" : block.slice(nl + 1);
            const text = a
              .replace(/```[\s\S]*?```/g, " ")
              .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
              .replace(/[`*_>#]/g, "")
              .replace(/\s+/g, " ")
              .trim()
              .slice(0, 500);
            return { q, text };
          })
          .filter((x) => x.q && x.text)
          .map((x) => ({
            "@type": "Question",
            name: x.q,
            acceptedAnswer: { "@type": "Answer", text: x.text },
          })),
      }
    : null;
---

<Layout
  title={`${entry.data.title} — Editora Docs`}
  description={entry.data.description ?? entry.data.title}
  ogImage="og/docs.png"
  canonicalPath={archived ? latestHref! : undefined}
>
  {
    faqJsonLd && faqJsonLd.mainEntity.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )
  }
  <div class="docs-wrap">
    <aside class="docs-sidebar">
      <nav>
        {
          cats.map((c) => (
            <div class="docs-cat">
              <h3>{c}</h3>
              {pages
                .filter((p) => p.entry.data.category === c)
                .map((p) => (
                  <a
                    href={href(p)}
                    class={p.entry.id === entry.id ? "active" : ""}
                  >
                    {p.entry.data.beta && <span class="beta-pill">Beta</span>}
                    {p.entry.data.title}
                  </a>
                ))}
            </div>
          ))
        }
        <div class="docs-cat">
          <h3>Reference</h3>
          {reference.map((r) => <a href={r.href}>{r.label}</a>)}
        </div>
        {
          docVersions.length > 1 && (
            <div class="docs-cat docs-versions">
              <h3>Version</h3>
              {docVersions.map((v) => (
                <a
                  href={v.base}
                  class={v.slug === docVersion.slug ? "active" : ""}
                >
                  {v.version}
                  {v.current && <span class="docs-version-tag">latest</span>}
                </a>
              ))}
            </div>
          )
        }
      </nav>
    </aside>

    <article
      class="docs-content doc"
      data-pagefind-body={archived ? undefined : true}
      data-pagefind-meta="kind:Docs"
    >
      {
        archived && (
          <p class="docs-version-note" data-pagefind-ignore>
            <strong>Editora {docVersion.version} docs.</strong> You are reading an
            archived version, kept so links from that release keep working.{" "}
            <a href={latestHref}>Read the {currentDocVersion.version} docs →</a>
          </p>
        )
      }
      <h1>
        {entry.data.beta && <span class="beta-pill">Beta</span>}
        {entry.data.title}
      </h1>
      <Content />

      <nav class="docs-pager" data-pagefind-ignore>
        {
          prev ? (
            <a class="prev" href={href(prev)}>
              <span>← Previous</span>
              {prev.entry.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={href(next)}>
              <span>Next →</span>
              {next.entry.data.title}
            </a>
          )
        }
      </nav>
    </article>
  </div>
</Layout>

<style>
  .docs-wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .docs-sidebar {
    position: sticky;
    top: 5rem;
  }

  .docs-cat {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .docs-cat h3 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin: 0 0 0.4rem;
  }

  .docs-cat a {
    color: var(--muted);
    font-size: 0.92rem;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    border-left: 2px solid transparent;
  }

  .docs-cat a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .docs-cat a.active {
    color: var(--text);
    background: var(--bg-soft);
    border-left-color: var(--accent);
  }

  /* Beta pill leads the title/sidebar entry, so the pills line up. */
  .docs-cat a .beta-pill,
  .docs-content h1 .beta-pill {
    margin-left: 0;
    margin-right: 0.4rem;
  }

  .docs-versions a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .docs-version-tag {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--faint);
  }

  /* Reading an archived version is a deliberate state, so it is stated at the
     top of the page rather than only implied by the URL. */
  .docs-version-note {
    margin: 0 0 1.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--muted);
    font-size: 0.9rem;
  }

  .docs-version-note strong {
    color: var(--text);
  }

  /* the .doc prose styles come from Layout's global stylesheet */
  .docs-content {
    max-width: none;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .docs-content h1 {
    margin-top: 0;
  }

  .docs-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .docs-pager a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-weight: 600;
    background: var(--bg-soft);
  }

  .docs-pager a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .docs-pager a.next {
    text-align: right;
    margin-left: auto;
  }

  .docs-pager span {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .docs-wrap {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .docs-sidebar {
      position: static;
    }
    .docs-cat {
      margin-bottom: 1rem;
    }
  }
</style>
