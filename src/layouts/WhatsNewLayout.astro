---
import { getCollection } from "astro:content";
import Layout from "./Layout.astro";
import { releaseSeries } from "../lib/release-series";

const { frontmatter, headings = [] } = Astro.props;
const activeSeries = frontmatter.series;

// "On this page": each release in the series (a "## [x.y.z] - date" heading), its
// sections (Added, Changed, Fixed…), and the news post that announced it, if any.
type Heading = { depth: number; slug: string; text: string };
const announcements = new Map(
  (await getCollection("news"))
    .filter((p) => p.data.version)
    .map((p) => [p.data.version as string, `/news/${p.id}/`]),
);
const releaseHeading = /^\[?([0-9][^\]\s]*)\]?\s*(?:[-–—]\s*([0-9]{4}-[0-9]{2}-[0-9]{2}))?/;
const fmtDate = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });
const releases: {
  version: string;
  date?: string;
  slug: string;
  sections: Heading[];
  post?: string;
}[] = [];
for (const h of headings as Heading[]) {
  const m = h.depth === 2 ? releaseHeading.exec(h.text) : null;
  if (m) {
    releases.push({
      version: m[1],
      date: m[2] ? fmtDate(m[2]) : undefined,
      slug: h.slug,
      sections: [],
      post: announcements.get(m[1]),
    });
  } else if (h.depth === 3 && releases.length > 0) {
    releases[releases.length - 1].sections.push(h);
  }
}
---

<Layout
  title={`${frontmatter.title} — Editora`}
  description={frontmatter.description ?? `Release notes for Editora ${activeSeries}.x, straight from the changelog.`}
  canonicalPath={frontmatter.canonical}
>
  <main class="page">
    <header class="page-heading">
      <h1>What's New in {activeSeries}.x</h1>
      <p class="lead">
        Everything shipped in the {activeSeries}.x release series, straight from
        the changelog. Each release's announcement, with the highlights, is on
        <a href="/news">News</a>.
      </p>
    </header>
    <div class="release-layout">
      <aside class="series-nav" aria-label="Release series">
        <span class="series-label">Release series</span>
        <nav>
          {
            releaseSeries.map((item) => (
              <a
                href={item.href}
                class:list={{ active: item.version === activeSeries }}
                aria-current={item.version === activeSeries ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </aside>
      <article class="doc release-notes">
        {
          releases.length > 0 && (
            <nav class="release-toc" aria-label="On this page">
              <ul>
                {releases.map((r) => (
                  <li>
                    <a href={`#${r.slug}`} class="release-link">
                      {r.version}
                    </a>
                    {r.date && <span class="release-date">{r.date}</span>}
                    {r.sections.map((sec) => (
                      <a href={`#${sec.slug}`}>{sec.text}</a>
                    ))}
                    {r.post && (
                      <a href={r.post} class="release-post">
                        Announcement
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <slot />
      </article>
    </div>
  </main>
</Layout>

<style>
  .page {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 3rem;
  }
  .page-heading {
    max-width: 52rem;
  }
  h1 {
    font-size: 2.4rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .lead {
    color: var(--muted);
    margin: 0;
  }
  .release-layout {
    display: grid;
    grid-template-columns: 9rem minmax(0, 52rem);
    gap: 2.5rem;
    align-items: start;
    margin-top: 2rem;
  }
  .series-nav {
    position: sticky;
    top: 5.25rem;
  }
  .series-label {
    display: block;
    margin-bottom: 0.65rem;
    color: var(--faint);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .series-nav nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .series-nav a {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .series-nav a:hover {
    color: var(--text);
    background: var(--bg-soft);
  }
  .series-nav a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .release-notes {
    max-width: none;
    margin: 0;
    padding: 0;
  }
  .release-toc {
    margin: 0 0 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    background: var(--bg-soft);
    font-size: 0.9rem;
  }
  .release-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 16rem;
    overflow-y: auto;
  }
  .release-toc li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.85rem;
    margin: 0;
    padding: 0.3rem 0;
  }
  .release-toc li + li {
    border-top: 1px solid var(--border-soft);
  }
  .release-toc .release-link {
    font-weight: 700;
    min-width: 3.75rem;
  }
  .release-toc .release-date {
    color: var(--faint);
    min-width: 6.5rem;
  }
  .release-toc .release-post {
    margin-left: auto;
  }

  @media (max-width: 760px) {
    .page {
      padding-top: 2rem;
    }
    .release-layout {
      display: block;
      margin-top: 1.5rem;
    }
    .series-nav {
      z-index: 2;
      top: 3.6rem;
      margin: 0 -1.25rem 1.75rem;
      padding: 0.7rem 1.25rem;
      border-top: 1px solid var(--border-soft);
      border-bottom: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg) 94%, transparent);
      backdrop-filter: blur(12px);
    }
    .series-label {
      margin-bottom: 0.45rem;
    }
    .series-nav nav {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.35rem;
    }
    .series-nav a {
      padding: 0.4rem 0.45rem;
      text-align: center;
    }
  }
</style>
