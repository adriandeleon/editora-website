---
// "How Editora compares" — the honest positioning page, and the proper home
// for the startup benchmark (the home page only has room for one line of
// methodology).
//
// Rules for this page: every number is one we measured ourselves, on one
// machine, with one method, and the method is written out in full below the
// table. Nothing here should claim a win Editora does not have; the single-file
// result is a tie with VS Code and it says so.
import Layout from "../layouts/Layout.astro";
import { repo, lspServerCount } from "../lib/editora";

const startup = {
  file: [
    { name: "Editora", ver: "0.22.0", ms: 521, lo: 511, hi: 529, self: true },
    { name: "VS Code", ver: "1.142.0", ms: 589, lo: 575, hi: 594 },
    { name: "IntelliJ IDEA", ver: "2026.2.3", ms: 2183, lo: 2139, hi: 2293 },
  ],
  project: [
    { name: "Editora", ver: "0.22.0", ms: 578, lo: 545, hi: 614, self: true },
    { name: "VS Code", ver: "1.142.0", ms: 664, lo: 654, hi: 664 },
    { name: "IntelliJ IDEA", ver: "2026.2.3", ms: 3156, lo: 2191, hi: 3973 },
  ],
};

const secs = (ms: number) => (ms / 1000).toFixed(2) + "s";

// The machine every figure on this page was measured on. A startup benchmark
// without the hardware under it is unfalsifiable, so this is listed part by
// part rather than summarised as "an M5".
const machine = [
  ["Model", "MacBook Pro (Mac17,2)"],
  ["Chip", "Apple M5, 10 cores (4 performance, 6 efficiency)"],
  ["Memory", "16 GB unified"],
  ["Storage", "Apple 1 TB internal SSD (APPLE SSD AP1024Z), 255 GB free"],
  ["OS", "macOS 27.0 (build 26A428)"],
  ["Displays", "AORUS FI32U at 5120\u00d72880 (main, where the windows opened), alongside the built-in 3024\u00d71964 Liquid Retina XDR"],
  ["Power", "AC, battery at 80%"],
];

// Where Editora genuinely differs, and where it plainly does not.
const rows = [
  {
    what: "Keybindings",
    editora: "Five complete keymaps (Emacs, CUA, Sublime, VS Code, IntelliJ), every command rebindable",
    others: "VS Code and IntelliJ ship keymap extensions for each other; Emacs is its own thing entirely",
  },
  {
    what: "Reaching a command",
    editora: "Everything is a registered command with an id, reachable by chord or fuzzy M-x search. No hidden actions",
    others: "VS Code's palette is close in spirit. IntelliJ hides a lot behind menus and dialogs",
  },
  {
    what: "Interface range",
    editora: "Four modes in one app, from Zen (bare text) to a full IDE, each a palette command away (Zen and Expert also have a chord in the Emacs keymap)",
    others: "VS Code and IntelliJ both have a Zen/distraction-free mode, but no equivalent spread",
  },
  {
    what: "Language support",
    editora: `${lspServerCount} language servers (Beta, switched on in Settings), using the ones already installed on your machine`,
    others: "VS Code's extension marketplace is far larger. IntelliJ's Java and Kotlin tooling is deeper than anything here",
  },
  {
    what: "Account and telemetry",
    editora: "None. No sign-in, no usage reporting, no subscription",
    others: "VS Code collects telemetry by default (it can be turned off). IntelliJ Ultimate is a paid licence",
  },
  {
    what: "Extensibility",
    editora: "A plugin API and a signed registry, small by comparison",
    others: "Tens of thousands of extensions for VS Code, a mature plugin market for IntelliJ",
  },
];
---

<Layout
  title="How Editora compares — Editora"
  description="How Editora compares to VS Code, IntelliJ IDEA, and Emacs, including startup measurements we ran ourselves and the method behind them."
  ogImage="og/compare.png"
>
  <main class="doc compare">
    <h1>How Editora compares</h1>
    <p class="lead">
      Editora does not try to replace every editor for every person. This page
      covers where it differs, where it does not, and what we measured.
    </p>

    <h2>Startup, measured</h2>
    <p>
      These measurements were taken in October&nbsp;2026 on
      Editora&nbsp;0.22.0. Both tables are the median of timed runs on the one
      machine below, with every editor fully quit between runs and launched the
      same way. The clock starts at launch and stops when a window owned by
      that editor carries the file's or project's name in its title.
    </p>
    <dl class="machine">
      {
        machine.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))
      }
    </dl>
    <p class="note">
      One machine is the point — every figure here is comparable with every
      other figure here, and with nothing else. A different Mac, a different
      macOS, a laptop on battery or one driving an external display will all
      give different numbers.
    </p>
    <p class="note">
      They replace a set taken in July&nbsp;2026, and the two are not
      comparable. The old harness polled for the window through
      <code>osascript</code>, which costs about 1.6&nbsp;seconds per poll, so
      every figure was rounded up to the next poll — which is why Editora and VS
      Code came out two milliseconds apart there, both simply caught on the
      first poll. The harness now polls the window server directly every
      5&nbsp;ms. Most of the apparent speedup across all three editors is that
      change in resolution, not three editors getting faster.
    </p>

    <h3>Opening a single file</h3>
    <table>
      <thead>
        <tr><th>Editor</th><th>Median</th><th>Range</th></tr>
      </thead>
      <tbody>
        {
          startup.file.map((r) => (
            <tr class={r.self ? "is-self" : ""}>
              <td>{r.name} <span class="ver">{r.ver}</span></td>
              <td><strong>{secs(r.ms)}</strong></td>
              <td class="range">{secs(r.lo)} to {secs(r.hi)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      Five runs each, opening a 710-line Markdown file with no project loaded.
      Editora is ahead of VS Code by 68&nbsp;ms, and the two spreads do not
      overlap, so the order is real — but it is a sixteenth of a second, which
      nobody will feel. What this does not show is the file's text arriving:
      Editora's own instrumentation puts its window at 475&nbsp;ms and its first
      painted frame at 890&nbsp;ms on this fixture, and VS Code and IntelliJ
      have a gap of their own that we cannot see from outside.
    </p>

    <h3>Opening a project folder</h3>
    <table>
      <thead>
        <tr><th>Editor</th><th>Median</th><th>Range</th></tr>
      </thead>
      <tbody>
        {
          startup.project.map((r) => (
            <tr class={r.self ? "is-self" : ""}>
              <td>{r.name} <span class="ver">{r.ver}</span></td>
              <td><strong>{secs(r.ms)}</strong></td>
              <td class="range">{secs(r.lo)} to {secs(r.hi)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="note">
      Three runs each, opening a 117&nbsp;MB source repository of 3,680 files (a
      clean clone of Editora's own). Treat IntelliJ's figure as the roughest of
      the six: its three runs came in at 3.97s, 3.16s and 2.19s, a spread far
      wider than its median is precise. The discarded warm-up runs are a better
      illustration still — VS Code's was 3.08s against the 0.66s it then settled
      to, so a cold first open of a project is a different measurement from any
      of these.
    </p>

    <h2>How the measurement works</h2>
    <p>
      Each editor is quit, the machine is left to settle, then the app's binary
      is launched with the file or folder as an argument. A watcher polls the
      window server every 5&nbsp;ms until that editor owns an on-screen window
      whose title names the file or project, and that is the moment recorded. A
      discarded warm-up run precedes the timed ones, so every editor is measured
      with a warm page cache.
    </p>
    <p>
      Waiting for <em>any</em> window would be easier, but it would give the
      wrong answer. IntelliJ puts up a splash window and then a welcome window
      titled only <code>IntelliJ IDEA</code> well before its editor exists, and
      timing either would have understated it by seconds. Matching on the window
      title is the only definition that means the same thing across an Electron
      app, a JetBrains IDE, and a JavaFX app.
    </p>
    <p>
      Each editor needs one flag to open only what is under test and restore
      nothing else: Editora is given <code>--no-session --new-instance</code>,
      and the project run also <code>--project</code>, because a bare folder
      argument leaves its title at plain <code>Editora</code> with no project
      name to match. VS Code gets <code>-n --disable-workspace-trust</code>.
      IntelliJ takes no such flag, so the project folder was added to its
      trusted paths beforehand rather than having a trust dialog block the run.
    </p>
    <p>
      A window appearing is not the same as the file being readable in it, and
      this measures the former. For Editora the difference is roughly
      400&nbsp;ms; for the other two it is unmeasurable from outside, so the
      figures are an early bound for all three rather than a like-for-like
      account of when you can start reading. Nor are they a cold boot, a measure
      of when indexing finishes, or a claim about your hardware: they are
      relaunches on one machine, and all three editors keep working in the
      background after their window arrives.
    </p>

    <h2>Where each one is strong</h2>
    <table class="matrix">
      <thead>
        <tr><th>&nbsp;</th><th>Editora</th><th>VS Code, IntelliJ, Emacs</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.what}</th>
              <td>{r.editora}</td>
              <td class="others">{r.others}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>When Editora is probably the wrong choice</h2>
    <ul>
      <li>
        You want a specific extension. Editora's plugin registry is small, and
        VS Code almost certainly has what you are looking for.
      </li>
      <li>
        You do heavy Java or Kotlin refactoring. IntelliJ's static analysis and
        refactoring tools go well beyond what a language server exposes.
      </li>
      <li>
        You already have a tuned Emacs configuration. Editora borrows the
        editing model, not the extensibility; nothing here replaces Elisp.
      </li>
    </ul>

    <h2>When it fits</h2>
    <p>
      You keep your hands on the keys and want every action to be a command you
      can find or rebind. You want language servers, a debugger, git, and live
      previews without an account or a subscription. And you want an editor that
      can be a bare page for writing and a full IDE for the same project ten
      seconds later.
    </p>
    <p>
      <a href="/#download">Download Editora</a> or
      <a href={repo}>read the source</a>.
    </p>
  </main>
</Layout>

<style>
  .compare table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0 0.5rem;
    font-size: 0.92rem;
  }
  .compare th,
  .compare td {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border-soft);
    vertical-align: top;
  }
  .compare thead th {
    color: var(--text);
    border-bottom-color: var(--border);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .compare tbody td {
    color: var(--muted);
  }
  .compare tr.is-self td {
    background: var(--accent-soft);
    color: var(--text);
  }
  .compare .machine {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.35rem 1rem;
    margin: 1.25rem 0 0.5rem;
    font-size: 0.88rem;
  }
  .compare .machine dt {
    color: var(--faint);
  }
  .compare .machine dd {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.92em;
  }

  @media (max-width: 560px) {
    .compare .machine {
      grid-template-columns: 1fr;
      gap: 0 0;
    }
    .compare .machine dt {
      margin-top: 0.6rem;
    }
  }

  .compare .ver {
    color: var(--faint);
    font-size: 0.82em;
    font-family: var(--mono);
  }
  .compare .range {
    color: var(--faint);
    font-family: var(--mono);
    font-size: 0.85em;
  }
  .compare .matrix th[scope="row"] {
    color: var(--text);
    width: 11rem;
    font-weight: 600;
  }
  .compare .matrix .others {
    color: var(--faint);
  }
  .compare .note {
    color: var(--faint);
    font-size: 0.86rem;
    margin: 0 0 2rem;
  }

  @media (max-width: 620px) {
    .compare .matrix th[scope="row"] {
      width: auto;
    }
    .compare table {
      font-size: 0.85rem;
    }
  }
</style>
