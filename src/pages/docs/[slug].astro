---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { currentDocVersion } from "../../lib/doc-versions";
import { appDocs } from "../../lib/app-docs";

// The current docs at their stable URL, /docs/<slug>: the canonical home of each
// page, so a release does not move every page to a new address. The versioned
// copy (/docs/v-<version>/<slug>) is still built, since each app version
// deep-links its own, and its canonical points here. The introduction stays at
// /docs/v-<version>/ (/docs redirects there). The copy inside the app serves
// only versioned URLs, so it builds none of these.
export async function getStaticPaths() {
  if (appDocs) return [];
  const live = await getCollection("docs");
  return live
    .filter((entry) => entry.id !== "introduction" && !entry.id.includes("/"))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<DocsLayout entry={entry} docVersion={currentDocVersion} stable />
