---
// Every screenshot on the site in one place, grouped, as thumbnails that open
// full size in the Lightbox. The list lives in src/lib/screenshots.ts; each
// feature's capture in public/screenshots/features/ joins its group on its own.
import Layout from "../layouts/Layout.astro";
import Lightbox from "../components/Lightbox.astro";
import { gallerySections } from "../lib/screenshots";

const sections = await gallerySections();
const total = sections.reduce((n, s) => n + s.shots.length, 0);
---

<Layout
  title="Screenshots — Editora"
  description={`${total} screenshots of Editora, the keyboard-driven editor: the editor, the Project Map, Git, the HTTP Client, previews, run and debug, settings and more.`}
>
  <main class="sg">
    <header class="sg-head">
      <h1>Screenshots</h1>
      <p class="sg-lead">
        {total} pictures of Editora, all taken from the real app. Click one to
        see it full size, then use <kbd>←</kbd> and <kbd>→</kbd> to step
        through the rest.
      </p>
      <nav class="sg-jump" aria-label="Screenshot sections">
        {
          sections.map((s) => (
            <a href={`#${s.id}`}>
              {s.title}
              <span class="sg-count">{s.shots.length}</span>
            </a>
          ))
        }
      </nav>
    </header>

    {
      sections.map((sec) => (
        <section class="sg-section" id={sec.id}>
          <h2>
            {sec.title}
            <span class="sg-count">{sec.shots.length}</span>
          </h2>
          {sec.lead && <p class="sg-sub">{sec.lead}</p>}
          <div class="sg-grid">
            {sec.shots.map((s) => (
              <figure class="sg-item">
                <a
                  class="sg-thumb"
                  href={s.src}
                  data-lb="gallery"
                  data-lb-dark={s.dark}
                  data-lb-caption={s.caption}
                  data-lb-alt={s.alt}
                  data-lb-more={s.more?.href}
                  data-lb-more-label={s.more?.label}
                >
                  <img class:list={{ "v-light": s.thumbDark }} src={s.thumb} alt={s.alt} loading="lazy" decoding="async" width="560" height="315" />
                  {s.thumbDark && (
                    <img class="v-dark" src={s.thumbDark} alt={s.alt} loading="lazy" decoding="async" width="560" height="315" />
                  )}
                </a>
                <figcaption>{s.title}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }
  </main>
  <Lightbox />
</Layout>

<style>
  .sg {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .sg-head h1 {
    font-size: 2.4rem;
    margin: 0 0 0.6rem;
    letter-spacing: -0.02em;
  }
  .sg-lead {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
    max-width: 44rem;
  }
  .sg-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sg-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text);
    font-size: 0.88rem;
  }
  .sg-jump a:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--accent);
  }
  .sg-count {
    color: var(--faint);
    font-size: 0.8em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .sg-section {
    margin-top: 2.75rem;
    scroll-margin-top: 4.5rem;
  }
  .sg-section h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .sg-sub {
    color: var(--muted);
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
  }
  .sg-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem 1rem;
    margin-top: 1rem;
  }
  .sg-item {
    margin: 0;
  }
  .sg-thumb {
    display: block;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-soft);
    cursor: zoom-in;
    transition: border-color 0.15s ease;
  }
  .sg-thumb:hover,
  .sg-thumb:focus-visible {
    border-color: var(--accent);
  }
  .sg-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.25s ease;
  }
  .sg-thumb:hover img {
    transform: scale(1.03);
  }
  .sg-item figcaption {
    margin-top: 0.5rem;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
  }
  @media (max-width: 600px) {
    .sg {
      padding-top: 2rem;
    }
    .sg-head h1 {
      font-size: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sg-thumb img {
      transition: none;
    }
  }
</style>
