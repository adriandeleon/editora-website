---
import Layout from "../layouts/Layout.astro";
import { readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, resolve, parse } from "node:path";
import { repo } from "../lib/editora";

const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base}/${p}`.replace(/\/{2,}/g, "/");

// Optional captions keyed by filename. Anything not listed gets a caption
// derived from its filename. Drop images into public/screenshots/ and they
// appear here automatically.
const captions: Record<string, string> = {
  "editor.jpg":
    "Editing a Java file — syntax highlighting, line-number gutter with bookmarks, minimap, and the status bar",
  "command-palette.jpg":
    "The M-x command palette — fuzzy-search and run any command",
  "bookmarks-panel.jpg":
    "The Bookmarks tool window, listing bookmarks across every file",
  "file-information.jpg":
    "The File Information panel — encoding, line endings, counts, and character details",
  "markdown-split.jpg":
    "Markdown split view — source on the left, live GitHub-style preview on the right",
  "markdown-preview-zen.jpg":
    "Markdown preview in Zen mode — distraction-free reading with rendered task lists",
  "doctor.jpg":
    "The Doctor screen — every external tool Editora can use, with found, warning, and missing status",
};

const here = dirname(fileURLToPath(import.meta.url));
const dir = resolve(here, "../../public/screenshots");
const exts = new Set([".png", ".jpg", ".jpeg", ".gif", ".webp", ".avif"]);

const prettify = (name: string) =>
  name
    .replace(/[-_]+/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .trim();

// Each shot ships as a WebP plus a JPG fallback of the same basename, so the
// gallery groups by basename — listing both would show every picture twice.
// The JPG is the <img> (universal fallback) and the WebP a <source>.
let shots: { src: string; webp?: string; alt: string; caption: string }[] = [];
try {
  const files = readdirSync(dir).filter((f) =>
    exts.has(parse(f).ext.toLowerCase()),
  );
  const byBase = new Map<string, string[]>();
  for (const f of files) {
    const base = parse(f).name;
    byBase.set(base, [...(byBase.get(base) ?? []), f]);
  }
  shots = [...byBase.keys()].sort().map((base) => {
    const group = byBase.get(base)!;
    const webp = group.find((f) => parse(f).ext.toLowerCase() === ".webp");
    // Fall back to whatever non-WebP variant exists, else the WebP itself.
    const fallback = group.find((f) => f !== webp) ?? webp!;
    const caption = captions[fallback] ?? captions[`${base}.jpg`] ?? prettify(base);
    return {
      src: url(`screenshots/${fallback}`),
      webp: webp && webp !== fallback ? url(`screenshots/${webp}`) : undefined,
      alt: caption,
      caption,
    };
  });
} catch {
  shots = [];
}
---

<Layout
  title="Screenshots — Editora"
  description="Screenshots of Editora: the editor, command palette, tool windows, themes, and Markdown preview."
>
  <main class="page">
    <h1>Screenshots</h1>
    <p class="lead">
      A look at Editora in action — the editor surface, command palette, tool
      windows, themes, and Markdown preview.
    </p>

    {
      shots.length > 0 ? (
        <div class="gallery">
          {shots.map((s) => (
            <figure class="shot">
              <a href={s.src} target="_blank" rel="noopener">
                <picture>
                  {s.webp && <source srcset={s.webp} type="image/webp" />}
                  <img
                    src={s.src}
                    alt={s.alt}
                    width="2720"
                    height="1700"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <div class="empty">
          <p>No screenshots yet.</p>
          <p class="empty-hint">
            Drop image files into <code>website/public/screenshots/</code> and
            they'll appear here automatically — the filename becomes the
            caption (e.g. <code>command-palette.png</code> →
            "Command Palette"). Add custom captions in the
            <code>captions</code> map at the top of
            <code>src/pages/screenshots.astro</code>.
          </p>
          <p>
            <a href={repo}>See the project on GitHub</a> in the meantime.
          </p>
        </div>
      )
    }
  </main>
</Layout>

<style>
  .page {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
  }

  h1 {
    font-size: 2.4rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .lead {
    color: var(--muted);
    max-width: 44rem;
    margin: 0 0 2.5rem;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .shot {
    margin: 0;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2720 / 1700;
    border-bottom: 1px solid var(--border);
  }

  .shot figcaption {
    padding: 0.75rem 1rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .empty {
    background: var(--bg-soft);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    padding: 2.5rem;
    text-align: center;
  }

  .empty p {
    margin: 0 0 0.75rem;
  }

  .empty p:first-child {
    font-size: 1.2rem;
    font-weight: 600;
  }

  .empty-hint {
    color: var(--muted);
    max-width: 40rem;
    margin: 0 auto 1rem;
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
