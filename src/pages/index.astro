---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { groupedFeatures } from "../lib/features";
import { version, repo } from "../lib/editora";
import { whatsNew } from "../lib/whatsnew";
import { commandGroups } from "../lib/commands";
import PaletteDemo from "../components/PaletteDemo.astro";
import PageToc from "../components/PageToc.astro";
import SpeedChart from "../components/SpeedChart.astro";
import ModeLadder from "../components/ModeLadder.astro";
import ToolBelt from "../components/ToolBelt.astro";
import LanguageWall from "../components/LanguageWall.astro";
import KeymapCompare from "../components/KeymapCompare.astro";
import ThemeGallery from "../components/ThemeGallery.astro";

const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base}/${p}`.replace(/\/{2,}/g, "/");
const logo = url("editora-icon.svg");

// Total registered commands — shown in the hero so the number stays accurate
// as commands.ts is regenerated.
const commandCount = commandGroups.reduce((n, g) => n + g.commands.length, 0);

// The hero's "See it in action" is a real screen capture when one is present
// (drop screenshots/hero-demo.mp4|webm into public/); until then the section
// falls back to a labelled poster stand-in over the real editor screenshot.
const heroVideo = ["mp4", "webm"]
  .map((e) => `screenshots/hero-demo.${e}`)
  .find((p) => existsSync(resolve("public", p)));

// Thumbnail for a feature card. Real captures (png/jpg/…) win; an SVG stand-in
// (generated by scripts/gen-placeholder-shots.mjs) is the last resort, so a
// dropped-in real screenshot automatically replaces the placeholder.
const shotExts = ["png", "jpg", "jpeg", "webp", "avif", "gif", "svg"];
const featureShot = (id: string) => {
  // Prefer the generated thumbnail. These cards render ~260px wide, so
  // pointing them at the full-size captures meant shipping 9.5 MB of PNGs for
  // the grid; the WebP thumbs are the same pictures at 0.24 MB total.
  // scripts/gen-thumbs.mjs builds them and runs as part of `npm run build`.
  const thumb = `screenshots/features/thumbs/${id}.webp`;
  if (existsSync(resolve("public", thumb))) return url(thumb);
  const p = shotExts
    .map((e) => `screenshots/features/${id}.${e}`)
    .find((fp) => existsSync(resolve("public", fp)));
  return p ? url(p) : null;
};

// Latest entries for the home-page teaser — News first, then Blog.
const byDate = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();
const newsItems = (await getCollection("news")).sort(byDate).map((e) => ({
  kind: "News",
  href: `/news/${e.id}`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  beta: e.data.beta,
}));
const blogItems = (await getCollection("blog")).sort(byDate).map((e) => ({
  kind: "Blog",
  href: `/blog/${e.id}`,
  title: e.data.title,
  description: e.data.description,
  date: e.data.date,
  beta: e.data.beta,
}));
// Interleaved by date. Concatenating put every news item first, so the section
// headed "From the blog & news" never actually showed a blog post.
const latest = [...newsItems, ...blogItems]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
    timeZone: "UTC",
  });

const featureGroups = await groupedFeatures();

const perfStats = [
  {
    stat: "Off the UI thread",
    body: "Tokenizing, parsing, and search run in the background, so the editor never blocks while you type.",
  },
  {
    stat: "Large files stay smooth",
    body: "5 MB+ skips highlighting and the minimap; 50 MB+ opens read-only with a capped load so a multi-GB log can't exhaust memory.",
  },
  {
    stat: "Incremental everything",
    body: "Edits re-tokenize only from the changed line; overlays and the gutter redraw just the visible lines, coalesced to one pass per frame.",
  },
  {
    stat: "Bounded memory",
    body: "Capped undo history and capped loads keep memory predictable, even on huge files.",
  },
];

const platforms = [
  { name: "macOS", note: "DMG installer (x64 / arm64)" },
  { name: "Windows", note: "MSI installer (x64)" },
  { name: "Linux", note: "DEB installer (x64 / arm64)" },
];
---

<Layout>
  <PageToc />

  <section class="hero">
    <div class="hero-inner">
      <img class="hero-logo" src={logo} alt="Editora logo" width="96" height="96" />
      <h2 class="hero-name">Editora</h2>
      <h1 class="hero-title">IDE power at text-editor speed</h1>
      <p class="tagline">
        A keyboard-driven editor where every action is a command, a keystroke
        or a fuzzy <kbd>M-x</kbd> search away. Pick your keymap (Emacs,
        VS&nbsp;Code, Sublime, IntelliJ, CUA) or bind your own. Fast,
        cross-platform, and quiet: no accounts, no telemetry.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href="#download">Download</a>
        <a class="btn btn-ghost" href="#see-it">See it in action</a>
      </div>

      <div class="badges">
        <a id="badge-stars" class="badge" href={`${repo}/stargazers`} hidden>
          <span class="badge-icon">★</span>
          <span id="badge-stars-count">—</span>
        </a>
        <a class="badge" href={`${repo}/blob/master/LICENSE`}>MIT License</a>
        <a id="badge-ci" class="badge" href={`${repo}/actions/workflows/ci.yml`} hidden>
          <span id="badge-ci-dot" class="badge-dot"></span>
          <span id="badge-ci-text">build</span>
        </a>
        <a class="badge" href={repo}>Open source on GitHub</a>
      </div>
    </div>

    <div class="hero-media">
      <PaletteDemo />
      <p class="hero-media-cap">
        The command palette, live. Every action is searchable and rebindable.
      </p>
    </div>
  </section>

  <main>
    <section id="see-it" class="section see-it">
      <h2>See it in action</h2>
      <p class="section-lead">
        The actual editor: syntax highlighting, a live preview, git gutters, LSP
        completion, and a status bar that stays out of your way.
      </p>
      {
        heroVideo ? (
          <video
            class="demo-video"
            src={url(heroVideo)}
            poster={url("screenshots/editor.jpg")}
            autoplay
            loop
            muted
            playsinline
            controls
          />
        ) : (
          <figure class="demo-poster">
            <img
              src={url("screenshots/editor.jpg")}
              alt="The Editora editor: a Java file with syntax highlighting, a line-number gutter with bookmarks, a minimap, and a status bar"
              width="3552"
              height="2420"
              fetchpriority="high"
            />
            <figcaption>
              <span class="demo-badge">Stand-in</span>
              A short screen capture will play here. This is the real editor
              (Primer&nbsp;Dark).
            </figcaption>
          </figure>
        )
      }
    </section>
    <section id="why" class="section why">
      <h2>Why Editora</h2>
      <p class="section-lead">
        A keyboard-first editor for people who'd rather keep their hands on the
        keys. Free, open source, and the same on macOS, Windows, and Linux.
      </p>
      <div class="pillars">
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="6" width="20" height="12" rx="2" />
            <path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M8 14h8" />
          </svg>
          <h3>Keyboard-first</h3>
          <p>
            Every action is a command you can bind or fuzzy-search. Five keymaps
            &mdash; Emacs, VS&nbsp;Code, Sublime, IntelliJ, CUA &mdash; fully
            rebindable, with macros, multiple cursors, and a prefix argument.
          </p>
        </div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="6" y="6" width="12" height="12" rx="1.5" />
            <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
          </svg>
          <h3>A full IDE, no bloat</h3>
          <p>
            LSP for 22 languages, step debugging, git &amp; GitHub, run &amp;
            test &mdash; in one fast native app that stays responsive on huge
            files. No accounts, no telemetry, no subscriptions.
          </p>
        </div>
        <div class="pillar">
          <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
            <circle cx="12" cy="12" r="3" />
          </svg>
          <h3>Previews everything</h3>
          <p>
            Markdown, Mermaid, CSV grids, diagrams, PDFs, and 20+ more file
            types render live, side by side with the source &mdash; no external
            browser.
          </p>
        </div>
      </div>

      <h3 class="why-sub">One editor, four ways to run it</h3>
      <p class="why-sub-lead">
        Editora scales with the task instead of asking you to pick a tool. The
        same app goes from a blank page for writing to a full IDE &mdash; and
        back &mdash; without reopening anything.
      </p>
      <ModeLadder />

      <p class="why-cta">
        <a class="btn btn-primary" href="#download">Download Editora</a>
        <span
          >Free and open source, for macOS, Windows, and Linux. <a
            href="/compare">See how it compares</a
          >.</span
        >
      </p>

      <h3 class="why-sub">Uses the tools you already have</h3>
      <p class="why-sub-lead">
        Editora doesn't bundle its own copy of your toolchain. It shells out to
        the CLIs already on your machine, so you get your versions and your
        config &mdash; and a feature stays invisible until its tool is found.
      </p>
      <ToolBelt />
    </section>

    {
      latest.length > 0 && (
        <section id="latest" class="section">
          <div class="latest-head">
            <h2>From the blog &amp; news</h2>
            <span class="latest-links">
              <a href="/news">All news</a> · <a href="/blog">All posts</a>
            </span>
          </div>
          <div class="latest-grid">
            {latest.map((p) => (
              <a class="latest-card" href={p.href}>
                <span class="latest-tags">
                  <span class={`latest-kind kind-${p.kind.toLowerCase()}`}>{p.kind}</span>
                  {p.beta && <span class="beta-pill">Beta</span>}
                </span>
                <span class="latest-title">{p.title}</span>
                {p.description && <span class="latest-desc">{p.description}</span>}
                <span class="latest-date">{fmtDate(p.date)}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    {
      whatsNew.length > 0 && (
        <section id="whats-new" class="section">
          <h2>What's new</h2>
          <p class="section-lead">
            A few of the most recent changes. See{" "}
            <a href="/whats-new">everything that's shipped</a>.
          </p>
          <ul class="news">
            {whatsNew.map((n) => (
              <li>
                <span class="news-title" set:html={n.title} />
                {n.detail && (
                  <span class="news-detail">
                    {": "}
                    <span set:html={n.detail} />
                  </span>
                )}
              </li>
            ))}
          </ul>
          <p class="whats-new-more">
            <a href="/whats-new">Show more &rarr;</a>
          </p>
        </section>
      )
    }

    <section id="features" class="section">
      <h2>Features</h2>
      {
        featureGroups.map((g) => (
          <div class="feature-group">
            <h3 class="feature-group-title">{g.title}</h3>
            <div class="grid">
              {g.items.map((f) => {
                const shot = featureShot(f.id);
                return (
                  <a class="card" href={`/features/${f.id}`}>
                    {shot ? (
                      <span class="card-shot">
                        <img
                          src={shot}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          width="560"
                          height="315"
                        />
                      </span>
                    ) : (
                      <span class="card-shot card-shot-empty" aria-hidden="true">
                        {"{ }"}
                      </span>
                    )}
                    <h4>
                      {f.data.title}
                      {f.data.beta && <span class="beta-pill">Beta</span>}
                    </h4>
                    <p set:html={f.data.summary} />
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }
    </section>

    <section id="languages" class="section">
      <h2>Works with your stack</h2>
      <p class="section-lead">
        Syntax highlighting for dozens of languages, and full language-server
        intelligence &mdash; completion, go-to-definition, diagnostics &mdash;
        for 21 of them. Plus live previews for the formats you actually read.
      </p>
      <LanguageWall />
    </section>

    <section id="keymaps" class="section">
      <h2>Your keymap, your keys</h2>
      <p class="section-lead">
        Bring the muscle memory you already have. Pick a keymap and every
        shortcut follows, or rebind any command to whatever you like.
      </p>
      <KeymapCompare />
    </section>

    <section id="themes" class="section">
      <h2>Make it yours</h2>
      <p class="section-lead">
        Ships with 25+ editor themes (and you can add your own). Try a few right
        here &mdash; the whole site recolors with the editor.
      </p>
      <ThemeGallery />
    </section>

    <section id="performance" class="section">
      <h2>Built for speed</h2>
      <p class="section-lead">
        Performance is a first-class goal: the UI thread stays free and work
        happens incrementally, off-thread, and only on what's visible.
      </p>
      <div class="perf">
        {
          perfStats.map((s) => (
            <div class="perf-item">
              <strong>{s.stat}</strong>
              <span>{s.body}</span>
            </div>
          ))
        }
      </div>

      <SpeedChart />
    </section>

    <section id="download" class="section">
      <h2>Download</h2>
      <p class="section-lead">
        Native installers and self-contained runnable jars for every platform
        are attached to each release.
      </p>
      <div class="platforms">
        {
          platforms.map((p) => (
            <div class="platform">
              <strong>{p.name}</strong>
              <span>{p.note}</span>
            </div>
          ))
        }
      </div>
      <div class="cta">
        <span class="dl-split">
          <a
            id="dl-primary"
            class="btn btn-primary dl-main"
            href={`${repo}/releases/latest`}
            data-repo={repo}
          >
            Download
          </a>
          <button
            id="dl-toggle"
            class="btn btn-primary dl-caret"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Show downloads for all platforms"
            hidden
          >
            <span aria-hidden="true">▾</span>
          </button>
          <div id="dl-menu" class="dl-menu" role="menu" hidden></div>
        </span>
        <a class="btn btn-ghost" href={`${repo}/releases`}>All releases</a>
      </div>
      <p id="dl-sub" class="note">
        Native installer (bundles a Java runtime, nothing else to install), or a
        self-contained <code>java -jar</code> on JDK&nbsp;25.
      </p>
      <p class="note">
        Installers are currently unsigned. On macOS, right-click the app and
        choose <em>Open</em> the first time.
      </p>
    </section>

    <section id="quickstart" class="section">
      <h2>Build &amp; run from source</h2>
      <p class="section-lead">
        Requires JDK&nbsp;25+. A Maven wrapper is bundled, so no local Maven
        install is needed.
      </p>
      <div class="code-window">
        <div class="code-chrome">
          <span class="dot"></span><span class="dot"></span><span class="dot"
          ></span>
          <span class="code-title">terminal</span>
        </div>
        <pre><code><span class="tok-comment"># Clone</span>
<span class="tok-keyword">git</span> clone {repo}.git
<span class="tok-keyword">cd</span> Editora

<span class="tok-comment"># Run the app</span>
./mvnw javafx:run

<span class="tok-comment"># Build a native installer (DMG / MSI / DEB)</span>
./mvnw <span class="tok-flag">-Pdist</span> package

<span class="tok-comment"># Build a self-contained runnable jar</span>
./mvnw <span class="tok-flag">-Pfatjar</span> package
<span class="tok-keyword">java</span> <span class="tok-flag">-jar</span> target/Editora-{version}.jar</code></pre>
      </div>
      <p class="note built-note">
        Built in the open with the help of AI coding tools &mdash; every change
        lands as a reviewed, tested commit on GitHub.
      </p>
    </section>
  </main>

  <script is:inline define:vars={{ repo }}>
    (function () {
      var api = repo.replace("https://github.com/", "https://api.github.com/repos/");

      // --- OS-detected download ---
      (function () {
        var btn = document.getElementById("dl-primary");
        if (!btn) return;
        var ua = navigator.userAgent;
        var plat = navigator.platform || "";
        var os = "Linux",
          exts = [".deb", ".appimage", ".rpm", ".tar.gz"];
        if (/Mac/i.test(ua)) {
          os = "macOS";
          exts = [".dmg", ".pkg"];
        } else if (/Win/i.test(ua)) {
          os = "Windows";
          exts = [".msi", ".exe"];
        }
        btn.textContent = "Download for " + os;

        // Detect CPU arch. Browsers report "MacIntel"/"Intel" even on Apple
        // Silicon, so beyond the UA/platform string (which catches Linux/Windows
        // ARM) use userAgentData.architecture (Chromium) and a WebGL "Apple GPU"
        // renderer heuristic (works in Safari) to catch M-series Macs.
        function webglIsApple() {
          try {
            var c = document.createElement("canvas");
            var gl = c.getContext("webgl") || c.getContext("experimental-webgl");
            if (!gl) return false;
            var dbg = gl.getExtension("WEBGL_debug_renderer_info");
            var r = dbg ? String(gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)) : "";
            return /apple/i.test(r) && !/intel|amd|radeon|nvidia/i.test(r);
          } catch (e) {
            return false;
          }
        }
        function detectArm(cb) {
          if (/aarch64|arm64|armv8|\barm\b/i.test(ua + " " + plat)) return cb(true);
          if (os === "Windows") return cb(false);
          var uad = navigator.userAgentData;
          if (uad && uad.getHighEntropyValues) {
            uad
              .getHighEntropyValues(["architecture"])
              .then(function (v) {
                cb(/arm|aarch/i.test(v.architecture || "") || webglIsApple());
              })
              .catch(function () {
                cb(webglIsApple());
              });
            return;
          }
          cb(webglIsApple());
        }

        detectArm(function (isArm) {
          var archPrefs = isArm ? ["arm64", "x64"] : ["x64", "arm64"];
          // Try to deep-link the matching asset from the latest release.
          fetch(api + "/releases/latest")
            .then(function (r) {
              return r.ok ? r.json() : null;
            })
            .then(function (rel) {
              if (!rel || !rel.assets) return;
              var pick = null;
              // Prefer an asset matching both the OS extension and the CPU arch
              // (asset names end with e.g. "-linux-x64.deb"); fall back to any
              // asset with the extension if no arch-specific match exists.
              for (var e = 0; e < exts.length && !pick; e++) {
                for (var a = 0; a < archPrefs.length && !pick; a++) {
                  for (var i = 0; i < rel.assets.length; i++) {
                    if (rel.assets[i].name.toLowerCase().endsWith(archPrefs[a] + exts[e])) {
                      pick = rel.assets[i];
                      break;
                    }
                  }
                }
              }
              for (var e2 = 0; e2 < exts.length && !pick; e2++) {
                for (var j = 0; j < rel.assets.length; j++) {
                  if (rel.assets[j].name.toLowerCase().endsWith(exts[e2])) {
                    pick = rel.assets[j];
                    break;
                  }
                }
              }
              if (pick) {
                btn.href = pick.browser_download_url;
                var sub = document.getElementById("dl-sub");
                if (sub && rel.tag_name)
                  btn.textContent = "Download for " + os + " (" + rel.tag_name + ")";
              }
              buildMenu(rel);
            })
            .catch(function () {});
        });

        // --- Every build, one click away ---
        // Asset names look like "Editora-0.9.5-macos-arm64.dmg"; anything that
        // doesn't (checksums.txt) is skipped.
        function assetInfo(name) {
          var m = name.match(/-(macos|windows|linux)-(arm64|aarch64|x64|x86_64)\.(.+)$/i);
          if (!m) return null;
          var p = m[1].toLowerCase();
          var arm = /arm|aarch/i.test(m[2]);
          var label =
            p === "macos"
              ? arm
                ? "macOS (Apple Silicon)"
                : "macOS (Intel)"
              : p === "windows"
                ? arm
                  ? "Windows (ARM64)"
                  : "Windows (x64)"
                : arm
                  ? "Linux (ARM64)"
                  : "Linux (x64)";
          return {
            plat: p,
            arm: arm,
            ext: m[3],
            label: label,
            meta: "." + m[3] + " · " + (arm ? "aarch64" : "x86_64"),
          };
        }

        function rank(map, key, dflt) {
          var v = map[String(key).toLowerCase()];
          return v === undefined ? dflt : v;
        }

        function buildMenu(rel) {
          var menu = document.getElementById("dl-menu");
          var toggle = document.getElementById("dl-toggle");
          if (!menu || !toggle || !rel || !rel.assets) return;

          var items = [];
          for (var i = 0; i < rel.assets.length; i++) {
            var info = assetInfo(rel.assets[i].name);
            if (!info) continue;
            info.url = rel.assets[i].browser_download_url;
            items.push(info);
          }
          if (!items.length) return;

          // macOS, Windows, Linux; native installers before portable jars.
          var platRank = { macos: 0, windows: 1, linux: 2 };
          var extRank = { dmg: 0, msi: 0, exe: 0, deb: 1, rpm: 2, appimage: 3, "tar.gz": 4, jar: 5 };
          items.sort(function (a, b) {
            return (
              rank(platRank, a.plat, 9) - rank(platRank, b.plat, 9) ||
              // Apple Silicon first on macOS, x86 first elsewhere.
              (a.plat === "macos" ? (b.arm ? 1 : 0) - (a.arm ? 1 : 0) : (a.arm ? 1 : 0) - (b.arm ? 1 : 0)) ||
              rank(extRank, a.ext, 9) - rank(extRank, b.ext, 9) ||
              a.ext.localeCompare(b.ext)
            );
          });

          menu.textContent = "";
          items.forEach(function (it) {
            var a = document.createElement("a");
            a.className = "dl-item";
            a.href = it.url;
            a.setAttribute("role", "menuitem");
            var main = document.createElement("span");
            main.className = "dl-item-main";
            var name = document.createElement("span");
            name.className = "dl-item-name";
            name.textContent = it.label;
            var meta = document.createElement("span");
            meta.className = "dl-item-meta";
            meta.textContent = it.meta;
            main.appendChild(name);
            main.appendChild(meta);
            var arrow = document.createElement("span");
            arrow.className = "dl-item-arrow";
            arrow.setAttribute("aria-hidden", "true");
            arrow.textContent = "→";
            a.appendChild(main);
            a.appendChild(arrow);
            a.addEventListener("click", close);
            menu.appendChild(a);
          });
          toggle.hidden = false;

          function close() {
            menu.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
          }
          toggle.addEventListener("click", function (e) {
            e.stopPropagation();
            if (menu.hidden) {
              menu.hidden = false;
              toggle.setAttribute("aria-expanded", "true");
            } else {
              close();
            }
          });
          document.addEventListener("click", function (e) {
            if (!menu.hidden && !menu.contains(e.target) && !toggle.contains(e.target)) close();
          });
          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !menu.hidden) {
              close();
              toggle.focus();
            }
          });
        }
      })();

      // --- GitHub stars ---
      fetch(api)
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || typeof d.stargazers_count !== "number") return;
          // Only surface the star count once it reads as social proof rather
          // than a liability; below the threshold the "Open source on GitHub"
          // badge already invites a star.
          if (d.stargazers_count < 25) return;
          var el = document.getElementById("badge-stars");
          document.getElementById("badge-stars-count").textContent =
            d.stargazers_count.toLocaleString();
          el.hidden = false;
        })
        .catch(function () {});

      // --- CI status (latest run on default branch) ---
      fetch(api + "/actions/workflows/ci.yml/runs?per_page=1")
        .then(function (r) {
          return r.ok ? r.json() : null;
        })
        .then(function (d) {
          if (!d || !d.workflow_runs || !d.workflow_runs.length) return;
          var run = d.workflow_runs[0];
          var ok = run.conclusion === "success";
          var el = document.getElementById("badge-ci");
          document.getElementById("badge-ci-text").textContent = ok
            ? "build passing"
            : "build " + (run.conclusion || run.status || "unknown");
          document.getElementById("badge-ci-dot").style.background = ok
            ? "#3fb950"
            : "#d29922";
          el.hidden = false;
        })
        .catch(function () {});
    })();
  </script>
</Layout>

