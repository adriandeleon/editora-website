---
import Layout from "../layouts/Layout.astro";
import { docsBase } from "../lib/editora";
const base = import.meta.env.BASE_URL;
const url = (p: string) => `${base}/${p}`.replace(/\/{2,}/g, "/");
---

<Layout title="Page not found — Editora" description="That page doesn't exist.">
  <main class="page">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p class="lead">
      That page doesn't exist. Search the site for it, or try one of these:
    </p>
    <div class="links">
      <button class="btn btn-primary" type="button" id="search-404">Search the site</button>
      <a class="btn btn-ghost" href={url(docsBase.slice(1))}>Docs</a>
      <a class="btn btn-ghost" href={url("features")}>Features</a>
      <a class="btn btn-ghost" href={url("commands")}>Commands</a>
      <a class="btn btn-ghost" href={url("keybindings")}>Keybindings</a>
      <a class="btn btn-ghost" href={url("")}>Home</a>
    </div>
  </main>
</Layout>

<script is:inline>
  // Open the site search with the missing page's name already typed in, so a
  // stale link (/docs/old-page-name) goes straight to what it was after.
  (function () {
    var btn = document.getElementById("search-404");
    var open = document.getElementById("search-open");
    if (!btn || !open) return;
    btn.addEventListener("click", function () {
      open.click();
      var input = document.getElementById("search-input");
      var last = location.pathname.split("/").filter(Boolean).pop() || "";
      var words = decodeURIComponent(last)
        .replace(/^v-[\d.]+$/, "")
        .replace(/[-_.]+/g, " ")
        .trim();
      if (input && words) {
        input.value = words;
        input.dispatchEvent(new Event("input"));
      }
    });
  })();
</script>

<style>
  .page {
    max-width: 40rem;
    margin: 0 auto;
    padding: 6rem 1.25rem;
    text-align: center;
  }

  .code {
    font-family: var(--mono);
    font-size: 4rem;
    font-weight: 700;
    color: var(--accent);
    margin: 0;
    line-height: 1;
  }

  h1 {
    font-size: 2rem;
    margin: 0.5rem 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .lead {
    color: var(--muted);
    margin: 0 0 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    font: inherit;
    cursor: pointer;
    padding: 0.6rem 1.3rem;
    border-radius: 999px;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .btn:hover {
    text-decoration: none;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--text);
    background: var(--bg-soft);
  }
</style>
