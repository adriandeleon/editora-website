---
import Layout from "../layouts/Layout.astro";
import { commandGroups, keymaps } from "../lib/commands";
import { formatChord } from "../lib/chord-format";
import { formatChordMac } from "../lib/chord-format-mac";

// For each bundled keymap, the command groups with at least one bound command,
// each with that keymap's chords on Windows/Linux and on macOS (the app loads a
// separate macOS file for every keymap but Emacs), written the way the app
// writes them. Derived from the same generated source as the Commands page, so
// it stays in sync automatically.
type Row = { title: string; pc: string[]; mac: string[] };
const byKeymap = keymaps.map((km) => {
  const groups = commandGroups
    .map((g) => ({
      title: g.title,
      rows: g.commands
        .map(
          (c): Row => ({
            title: c.title,
            pc: c.bindings?.[km.id]
              ? [c.bindings[km.id], ...(c.alt?.[km.id] ?? [])].map((k) => formatChord(k, km.id))
              : [],
            mac: c.mac?.[km.id]
              ? [c.mac[km.id], ...(c.macAlt?.[km.id] ?? [])].map((k) => formatChordMac(k, km.id))
              : [],
          }),
        )
        .filter((r) => r.pc.length > 0 || r.mac.length > 0),
    }))
    .filter((g) => g.rows.length > 0);
  const rows = groups.flatMap((g) => g.rows);
  const pcCount = rows.filter((r) => r.pc.length > 0).length;
  const macCount = rows.filter((r) => r.mac.length > 0).length;
  return { ...km, groups, pcCount, macCount };
});

// Which platform a row belongs to, so the CSS can hide a row the other
// platform doesn't bind.
const rowClass = (r: Row) =>
  r.pc.length === 0 ? "mac-only" : r.mac.length === 0 ? "pc-only" : undefined;
---

<Layout
  title="Keybindings — Editora"
  description="Editora's keymaps: Emacs (default), CUA, Sublime Text, VS Code, and IntelliJ IDEA. Every command with its default bindings on Windows, Linux and macOS, grouped by area. Rebind anything in Settings → Keymaps."
>
  <main class="page">
    <h1>Keybindings</h1>
    <p class="lead">
      Editora ships five keymaps; pick one below. <strong>Emacs</strong> is the
      default; you can switch to any of them (or rebind any command) in
      <strong>Settings → Keymaps</strong>. Every binding maps to a
      <strong>command</strong>, so the same actions are also reachable from the
      command palette (see the full <a href="/commands">command list</a>).
    </p>

    <div class="legend">
      <p>
        Chords are written the way Editora writes them. The <strong>Emacs</strong>
        keymap uses Emacs notation on every platform:
        <kbd>C-</kbd> Control, <kbd>M-</kbd> Alt / Option (Meta),
        <kbd>S-</kbd> Shift, <kbd>Cmd-</kbd> Command; space-separated keys are a
        sequence, e.g. <kbd>C-x</kbd> then <kbd>C-s</kbd>.
      </p>
      <p>
        The other keymaps use the platform's notation:
        <kbd>Ctrl+Shift+P</kbd> on Windows and Linux, and
        <kbd>⌃</kbd> Control, <kbd>⌥</kbd> Option, <kbd>⇧</kbd> Shift,
        <kbd>⌘</kbd> Command on macOS, as in <kbd>⇧⌘P</kbd>.
        Where a command has more than one chord, the first is the one Editora
        shows in its menus and palette.
      </p>
    </div>

    <form class="keymaps">
      <input type="radio" name="os" id="os-pc" class="km-radio" checked />
      <input type="radio" name="os" id="os-mac" class="km-radio" />
      {
        byKeymap.map((km, i) => (
          <input
            type="radio"
            name="km"
            id={`km-${km.id}`}
            class="km-radio"
            checked={i === 0}
          />
        ))
      }
      <div class="os-switch">
        <span class="os-label" id="os-label">Platform</span>
        <label for="os-pc" class="os-opt">Windows / Linux</label>
        <label for="os-mac" class="os-opt">macOS</label>
      </div>
      <div class="tabs">
        {
          byKeymap.map((km) => (
            <label for={`km-${km.id}`} class="tab">
              {km.name}
            </label>
          ))
        }
      </div>

      <div class="km-panels">
        {
          byKeymap.map((km) => (
            <section class="km-panel" id={`panel-${km.id}`}>
              <p class="km-count">
                <strong>{km.name}</strong>:{" "}
                <span class="pc">{km.pcCount} commands with a default binding on Windows and Linux.</span>
                <span class="mac">{km.macCount} commands with a default binding on macOS.</span>
              </p>
              <div class="columns">
                {km.groups.map((g) => (
                  <section class="group">
                    <h2>{g.title}</h2>
                    <table>
                      <tbody>
                        {g.rows.map((r) => (
                          <tr class={rowClass(r)}>
                            <td class="keys">
                              {[
                                { cls: "pc", chords: r.pc },
                                { cls: "mac", chords: r.mac },
                              ].map((p) => (
                                <span class={p.cls}>
                                  {p.chords.map((chord, i) => (
                                    <span class={i === 0 ? "chord" : "chord alt"}>
                                      {i > 0 && <span class="or">or</span>}
                                      {chord.split(" ").map((tok) => (
                                        <kbd>{tok}</kbd>
                                      ))}
                                    </span>
                                  ))}
                                </span>
                              ))}
                            </td>
                            <td class="desc">{r.title}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </section>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </form>

    <p class="note">
      <strong>macOS:</strong> Editora reads a separate macOS keymap for CUA,
      Sublime Text, VS Code, and IntelliJ, so a few chords differ by more than
      <kbd>⌘</kbd> for Ctrl; pick <em>macOS</em> above to see them. The Emacs
      keymap is the same on every platform. In the Emacs keymap, the Option dead
      keys (<kbd>Option</kbd>+<kbd>e</kbd>/<kbd>i</kbd>/<kbd>u</kbd>/<kbd>n</kbd>/<kbd
        >`</kbd
      >) are intercepted by the OS for accent composition, so a few
      <kbd>M-</kbd> chords like <kbd>M-e</kbd> aren't reachable by keyboard there.
      The command palette still works.
    </p>
  </main>
</Layout>

<script is:inline>
  // Open on the reader's own platform; the radios work without this.
  (function () {
    var ua = navigator.userAgentData;
    var platform = (ua && ua.platform) || navigator.platform || "";
    if (/mac|iphone|ipad/i.test(platform)) {
      var mac = document.getElementById("os-mac");
      if (mac) mac.checked = true;
    }
  })();
</script>

<style>
  .page {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
  }

  h1 {
    font-size: 2.4rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .lead {
    color: var(--muted);
    max-width: 44rem;
    margin: 0 0 1.5rem;
  }

  .legend {
    padding: 1rem 1.25rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .legend p {
    margin: 0;
  }

  .legend p + p {
    margin-top: 0.6rem;
  }

  /* Platform switcher: two hidden radios drive which chord column shows. */
  .os-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .os-label {
    color: var(--muted);
    margin-right: 0.35rem;
  }

  .os-opt {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    user-select: none;
  }

  .os-opt:hover {
    color: var(--text);
  }

  #os-pc:checked ~ .os-switch label[for="os-pc"],
  #os-mac:checked ~ .os-switch label[for="os-mac"] {
    color: var(--text);
    background: var(--bg-soft);
    font-weight: 600;
  }

  #os-pc:focus-visible ~ .os-switch label[for="os-pc"],
  #os-mac:focus-visible ~ .os-switch label[for="os-mac"],
  #km-emacs:focus-visible ~ .tabs label[for="km-emacs"],
  #km-cua:focus-visible ~ .tabs label[for="km-cua"],
  #km-sublime:focus-visible ~ .tabs label[for="km-sublime"],
  #km-vscode:focus-visible ~ .tabs label[for="km-vscode"],
  #km-intellij:focus-visible ~ .tabs label[for="km-intellij"] {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mac {
    display: none;
  }

  #os-mac:checked ~ .km-panels .mac {
    display: inline;
  }

  #os-mac:checked ~ .km-panels .pc,
  #os-mac:checked ~ .km-panels tr.pc-only,
  #os-pc:checked ~ .km-panels tr.mac-only {
    display: none;
  }

  /* Keymap switcher: hidden radios drive the tab bar + panels via :checked. */
  .km-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .tab {
    padding: 0.5rem 0.9rem;
    border: 1px solid transparent;
    border-bottom: none;
    border-top-left-radius: var(--radius);
    border-top-right-radius: var(--radius);
    color: var(--muted);
    cursor: pointer;
    font-size: 0.95rem;
    user-select: none;
    margin-bottom: -1px;
  }

  .tab:hover {
    color: var(--text);
  }

  .km-panel {
    display: none;
  }

  /* Show the panel + highlight the tab for the checked keymap (one rule per keymap). */
  #km-emacs:checked ~ .km-panels #panel-emacs,
  #km-cua:checked ~ .km-panels #panel-cua,
  #km-sublime:checked ~ .km-panels #panel-sublime,
  #km-vscode:checked ~ .km-panels #panel-vscode,
  #km-intellij:checked ~ .km-panels #panel-intellij {
    display: block;
  }

  #km-emacs:checked ~ .tabs label[for="km-emacs"],
  #km-cua:checked ~ .tabs label[for="km-cua"],
  #km-sublime:checked ~ .tabs label[for="km-sublime"],
  #km-vscode:checked ~ .tabs label[for="km-vscode"],
  #km-intellij:checked ~ .tabs label[for="km-intellij"] {
    color: var(--text);
    border-color: var(--border);
    background: var(--bg-soft);
    font-weight: 600;
  }

  .km-count {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .columns {
    columns: 2;
    column-gap: 2rem;
  }

  .group {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  .group h2 {
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  td {
    padding: 0.3rem 0;
    vertical-align: top;
  }

  td.keys {
    padding-right: 1rem;
    width: 1%;
  }

  td.keys kbd + kbd {
    margin-left: 0.25rem;
  }

  /* A command's chords stack, the one the app shows first. */
  .chord {
    display: block;
    white-space: nowrap;
  }

  .chord.alt {
    margin-top: 0.15rem;
  }

  .or {
    color: var(--faint);
    font-size: 0.8rem;
    margin-right: 0.4rem;
  }

  td.desc {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-size: 0.9rem;
    color: var(--text);
  }

  @media (max-width: 720px) {
    .columns {
      columns: 1;
    }
  }
</style>
