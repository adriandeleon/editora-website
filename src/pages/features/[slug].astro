---
import { getCollection, render } from "astro:content";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import sharp from "sharp";
import Layout from "../../layouts/Layout.astro";
import { featureShotAlt, groupedFeatures, groupId } from "../../lib/features";

export async function getStaticPaths() {
  const features = await getCollection("features");
  return features.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Screenshot: drop one at public/screenshots/features/<slug>.<ext> and it shows.
// Real captures (png/jpg/…) win; an SVG stand-in is the last resort, so a
// dropped-in real screenshot automatically replaces the generated placeholder.
const exts = ["png", "jpg", "jpeg", "webp", "gif", "avif", "svg"];
const shot = exts
  .map((e) => `screenshots/features/${entry.id}.${e}`)
  .find((p) => existsSync(resolve("public", p)));
// A `<slug>.dark.<ext>` twin, when there is one, is shown in the dark site
// themes instead (the .doc-figure rules in Layout.astro pick one).
const shotDark = shot
  ? shot.replace(/(\.[a-z]+)$/, ".dark$1")
  : null;
const hasDark = shotDark !== null && existsSync(resolve("public", shotDark));
// The capture's pixel size, for the <img> width and height (so the page does
// not shift as the picture loads). sharp reads only the header. The light and
// dark twins are taken at the same size. src/lib/screenshots.ts has its own
// header reader for the gallery, but keeps it private.
const size = shot ? await sharp(resolve("public", shot)).metadata() : null;
const dims = size?.width && size?.height ? { width: size.width, height: size.height } : {};
// A real capture doubles as the page's social card; an SVG stand-in does not
// (most link previews do not render SVG), so that keeps the generic card.
const ogImage = shot && !shot.endsWith(".svg") ? shot : undefined;

// Sibling features in the same group, for "Related".
const groups = await groupedFeatures();
const group = groups.find((g) => g.items.some((f) => f.id === entry.id));
const related = (group?.items ?? []).filter((f) => f.id !== entry.id).slice(0, 6);

// Meta description: the page's own plain-text `description`, else the summary
// with its tags stripped and its HTML entities decoded (so no literal &amp;).
const decodeEntities = (s: string) =>
  s
    .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)))
    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)))
    .replace(/&(lt|gt|quot|apos|nbsp|amp);/g, (_, e) =>
      ({ lt: "<", gt: ">", quot: '"', apos: "'", nbsp: " ", amp: "&" })[e as string] ?? "",
    );
const description =
  entry.data.description ?? decodeEntities(entry.data.summary.replace(/<[^>]+>/g, ""));
---

<Layout
  title={`${entry.data.title} — Editora`}
  description={description}
  ogImage={ogImage}
>
  <main class="doc feature" data-pagefind-body data-pagefind-meta="kind:Feature">
    <p class="back"><a href={group ? `/features#${groupId(group.title)}` : "/features"}>← All features</a></p>
    <h1>
      {entry.data.title}
      {entry.data.beta && <span class="beta-pill">Beta</span>}
    </h1>
    <p class="summary" set:html={entry.data.summary} />

    {
      shot ? (
        <figure class="shot doc-figure">
          <a class={`doc-figure-link${hasDark ? " doc-figure-light" : ""}`} href={`/${shot}`} title="Open the full-size screenshot">
            <img src={`/${shot}`} alt={featureShotAlt(entry)} {...dims} />
          </a>
          {hasDark && (
            <a class="doc-figure-link doc-figure-dark" href={`/${shotDark}`} title="Open the full-size screenshot">
              <img src={`/${shotDark}`} alt={featureShotAlt(entry)} {...dims} />
            </a>
          )}
        </figure>
      ) : (
        <div class="shot-placeholder" aria-hidden="true">
          <span>Screenshot coming soon</span>
        </div>
      )
    }

    <Content />

    {
      related.length > 0 && (
        <section class="related">
          <h2>More in {group?.title}</h2>
          <ul>
            {related.map((f) => (
              <li>
                <a href={`/features/${f.id}`}>{f.data.title}</a>
                {f.data.beta && <span class="beta-pill">Beta</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>

<style>
  .back {
    margin: 0 0 1rem;
    font-size: 0.9rem;
  }
  .summary {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 2rem;
  }
  .shot {
    margin: 0 0 2.5rem;
  }
  .shot .doc-figure-link {
    border-radius: var(--radius);
  }
  .shot-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    margin: 0 0 2.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    background: var(--bg-soft);
    color: var(--faint);
    font-size: 0.95rem;
  }
  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .related h2 {
    font-size: 1.1rem;
    margin: 0 0 0.75rem;
  }
  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .related li {
    display: flex;
    align-items: center;
  }
  .related .beta-pill {
    margin-left: 0.35rem;
  }
</style>
