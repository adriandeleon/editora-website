---
import Layout from "../../layouts/Layout.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import MapSpotlight from "../../components/MapSpotlight.astro";
import Lightbox from "../../components/Lightbox.astro";
import { groupedFeatures, groupId } from "../../lib/features";
import { docsBase } from "../../lib/editora";

const groups = await groupedFeatures();
const total = groups.reduce((n, g) => n + g.items.length, 0);
---

<Layout
  title="Features — Editora"
  description={`All ${total} features of Editora, the keyboard-driven editor: commands and keymaps, editing, language servers, run and debug, Git, previews, the Project Map, and more.`}
>
  <main class="features-page">
    <header class="fp-head">
      <h1>Features</h1>
      <p class="fp-lead">
        Everything Editora does, in {total} features across {groups.length} areas.
        Each card opens a page with the details and links into the
        <a href={docsBase}>docs</a>, or see them all in the
        <a href="/screenshots">screenshot gallery</a>.
      </p>
      <nav class="fp-jump" aria-label="Feature areas">
        <a href="#project-map">Project Map</a>
        {
          groups.map((g) => (
            <a href={`#${groupId(g.title)}`}>
              {g.title}
              <span class="fp-count">{g.items.length}</span>
            </a>
          ))
        }
      </nav>
    </header>

    <section class="fp-spot">
      <MapSpotlight id="project-map" gallery />
    </section>

    {
      groups.map((g) => (
        <section class="fp-group" id={groupId(g.title)}>
          <h2>
            {g.title}
            <span class="fp-count">{g.items.length}</span>
          </h2>
          <div class="grid">
            {g.items.map((f) => (
              <FeatureCard feature={f} />
            ))}
          </div>
        </section>
      ))
    }
  </main>
  <Lightbox />
</Layout>

<style>
  .features-page {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 3rem 1.25rem 4rem;
  }
  .fp-head h1 {
    font-size: 2.4rem;
    margin: 0 0 0.6rem;
    letter-spacing: -0.02em;
  }
  .fp-lead {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 1.5rem;
    max-width: 44rem;
  }
  .fp-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .fp-jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text);
    font-size: 0.88rem;
  }
  .fp-jump a:hover {
    text-decoration: none;
    border-color: var(--accent);
    color: var(--accent);
  }
  .fp-count {
    color: var(--faint);
    font-size: 0.8em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .fp-spot {
    margin: 2.75rem 0 1rem;
    padding: 2.25rem 0 3rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .fp-group {
    margin-top: 2.75rem;
    scroll-margin-top: 4.5rem;
  }
  .fp-group h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--faint);
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  @media (max-width: 600px) {
    .features-page {
      padding-top: 2rem;
    }
    .fp-head h1 {
      font-size: 2rem;
    }
  }
</style>
